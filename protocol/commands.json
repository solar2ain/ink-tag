  "imageReadingOrientationPolicy": {
    "version": 1,
    "pilot": "TLSR8359",
    "capabilityExtension": "IMAGE_READING_ORIENTATION",
    "capabilitiesExtension": "GET_CAPABILITIES bytes24..27 little-endian uint32; absent before28 bytes means zero; bytes17..23 keep their existing settings meaning",
    "descriptor": "DIRECT_FRAME and STORED_IMAGE byte3 bits2..3 encode clockwise quarter turns from upright reading canvas to unchanged logical screen; bits0..1 retain segment black mask, bit6=LZO1X and bit7=reserved PACKBITS_RLE; bits4..5 must be zero and the two codec bits cannot be combined",
    "storage": "Existing96-byte IKI1 header black_mask byte12 retains bits0..3; strip both wire-only compression bits6/7; no new field, stride, partition, boot write or migration",
    "overlay": "Device-enforced badge in reading-frame bottom-right, composed before existing profile rotation/mirrors; base cannot choose position/hide; Pro suppression still needs device entitlement",
    "qualification": "Advertise only after direct, stored, replacement, cold reopen, slideshow and failure/cancel cleanup consume the same metadata; other ports remain zero",
    "fallback": "Unadvertised devices receive original flags only and retain fixed screen-oriented badge; never silently send orientation bits to them"
