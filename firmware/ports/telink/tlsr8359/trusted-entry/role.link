/* Retains pinned SDK section roles and retention/cache placement. Only XIP
 * text and .data load pointers move to a role's absolute physical Flash base.
 * ROLE_BASE is supplied by the unsigned research driver, never production. */
ENTRY(__start)
SECTIONS {
  . = 0;
  .vectors : { *(.vectors*) }
  ASSERT(SIZEOF(.vectors)==0x140,"native vector size changed; cannot place signed address binding")
  .boot_binding : { KEEP(*(.inktag_boot_binding)) }
  ASSERT(SIZEOF(.boot_binding)==20,"signed native address binding missing or duplicated")
  .ram_code : { *(.ram_code*) }
  . = ALIGN(.,4);
  _rstored_ = ABSOLUTE(.);
  . = ROLE_BASE + __RAM_RETENTION_SIZE;
  .text : AT(__RAM_RETENTION_SIZE) { *(.text*) }
  .rodata : { *(.rodata*) }
  . = ALIGN(.,4);
  _dstored_ = ABSOLUTE(.);
  _dstored_bin_ = ABSOLUTE(.) - ROLE_BASE;
  _code_size_ = _dstored_bin_;
  . = __RAM_START_ADDR + _rstored_;
  .retention_data : AT(_rstored_) {
    _retention_data_start_ = ABSOLUTE(.);
    *(.retention_data*)
  }
  _retention_data_end_ = ABSOLUTE(.);
  . = ALIGN(.,16);
  _icload_size_div_16_ = (. - __RAM_START_ADDR) / 16;
  . = __RAM_START_ADDR + __RAM_RETENTION_SIZE;
  _ictag_addr_div_256_ = (. - __RAM_START_ADDR) / 256;
  _ictag_start_ = .;
  . += 0x100;
  _ictag_end_ = .;
  . += 0x800;
  _icdata_end_ = .;
  .data : AT(_dstored_bin_) {
    . = ALIGN(.,4);
    _start_data_ = .;
    *(.data*)
    . = ALIGN(.,4);
    _end_data_ = .;
  }
  .bss : {
    _start_bss_ = .;
    *(.sbss*) *(.bss*) *(COMMON)
    _end_bss_ = .;
  }
  _bin_size_ = _code_size_ + _end_data_ - _start_data_;
  /* Native SRAM loader occupies F000..FFFF during a role handoff. A fixed
   * stack margin is explicit; a successful link is not a measured watermark. */
  ASSERT(_end_bss_ + 0x800 <= ROLE_STACK_END,"trusted role exceeds SRAM/stack budget")
  ASSERT(_icload_size_div_16_ * 16 <= 0x8000,"RAM prefix exceeds native load bound")
  ASSERT(_bin_size_ + 4 + ROLE_SIGNATURE_BYTES <= ROLE_CAPACITY,"trusted role exceeds Flash budget")
}
