{
  "name": "inktag-webui",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:device-fonts": "node tools/generate-device-fonts.mjs && node tools/generate-glyph-catalog.mjs",
    "predev": "npm run generate:device-fonts && node tools/verify-native-preview.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run generate:device-fonts && node tools/verify-native-preview.mjs && node tools/build-host-scene.mjs",
    "build": "tsc -b && vite build --mode static && vite build --mode standalone && node tools/finalize-standalone.mjs && node tools/verify-builds.mjs",
    "preview": "vite preview --mode static --host 0.0.0.0",
    "pretest": "npm run generate:device-fonts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:ota-browser": "node tools/verify-ota-browser.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.0.1",
    "dexie": "latest",
    "epdoptimize": "1.3.0",
    "lucide-react": "latest",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "rgbquant": "1.1.2",
    "zustand": "latest"
  },
  "devDependencies": {
    "@leafer-editor/miniapp": "2.2.10",
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "leafer-editor": "2.2.10",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "latest"
  },
  "overrides": {
    "epdoptimize@1.3.0": {
      "rgbquant": "npm:rgbquant@1.1.2"
    }
  }
}
