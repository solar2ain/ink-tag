// Reuse the OM read tools' qualified DAP polling and GR early-halt sequence.
// InitTarget permits only low-level DAP access: no MEM_, Flash or reset APIs.
// The host substitutes bounded integers, never operator-supplied script text.
static int _Used;
static int _UnstableReported;
static int _AwaitHostStop;
static int _RequireHeld;

// Returning failure lets 7.88j try a reset-pin connection fallback. Instead
// park after a terminal marker until the owning host stops this process.
static void _WaitForHostStop(void) {
  _AwaitHostStop = 1;
  while (_AwaitHostStop != 0) { JLINK_SYS_Sleep(100); }
}

static int _Unstable(void) {
  if (_UnstableReported == 0) {
    _UnstableReported = 1;
    JLINK_SYS_Report("OM_CAPTURE_UNSTABLE: waiting for consistent DAP/core reads.");
  }
  return 1;
}

static U32 _Read32(U32 addr) {
  if (JLINK_CORESIGHT_WriteAP(JLINK_CORESIGHT_AP_REG_ADDR, addr) < 0) { return 0; }
  return JLINK_CORESIGHT_ReadAP(JLINK_CORESIGHT_AP_REG_DATA);
}

static int _TryOm(void) {
  int r;
  U32 v;
  U32 sys;
  U32 chip;
  r = JLINK_CORESIGHT_Configure("IRPre=0;DRPre=0;IRPost=0;DRPost=0;IRLenDevice=4");
  if (r < 0) { return 1; }
  v = JLINK_CORESIGHT_ReadDP(JLINK_CORESIGHT_DP_REG_IDCODE);
  if ((v & 0x0F000FFF) != 0x0B000477) { return 1; }
  r = JLINK_CORESIGHT_WriteDP(JLINK_CORESIGHT_DP_REG_ABORT, 0x1E);
  r |= JLINK_CORESIGHT_WriteDP(JLINK_CORESIGHT_DP_REG_CTRL_STAT, 0x50000000);
  if (r < 0) { return 1; }
  v = JLINK_CORESIGHT_ReadDP(JLINK_CORESIGHT_DP_REG_CTRL_STAT);
  if ((v & 0xA0000000) != 0xA0000000) { return 1; }
  r = JLINK_CORESIGHT_WriteDP(JLINK_CORESIGHT_DP_REG_SELECT, 0);
  r |= JLINK_CORESIGHT_WriteAP(JLINK_CORESIGHT_AP_REG_CTRL, 0x23000002);
  if (r < 0) { return 1; }
  v = _Read32(0xE000ED00);
  if (v == 0 || v == 0xFFFFFFFF) { return 1; }
  if (_Read32(0xE000ED00) != v) { return _Unstable(); }
  if ((JLINK_CORESIGHT_ReadDP(JLINK_CORESIGHT_DP_REG_CTRL_STAT) & 0xA00000B2) != 0xA0000000) { return _Unstable(); }
  if ((v & 0xFF000000) != 0x41000000 ||
      ((v & 0x000F0000) != 0x000F0000 && (v & 0x000F0000) != 0x000C0000)) { return _Unstable(); }
  if ((v & 0xFF00FFF0) != 0x4100C240) {
    JLINK_SYS_Report("OM_CAPTURE_WRONG_CPUID: stable foreign core; stopping.");
    return -1;
  }
  sys = _Read32(0x40000000);
  chip = _Read32(0x40000004);
  if (sys == 0 || sys == 0xFFFFFFFF || chip == 0 || chip == 0xFFFFFFFF) { return _Unstable(); }
  if (_Read32(0x40000000) != sys || _Read32(0x40000004) != chip) { return _Unstable(); }
  if ((JLINK_CORESIGHT_ReadDP(JLINK_CORESIGHT_DP_REG_CTRL_STAT) & 0xA00000B2) != 0xA0000000) { return _Unstable(); }
  // Match Full's SYS revision and low-16-bit chip-family gates. The complete
  // observed chip word is 00A16626, not an exact 00006626 equality.
  if ((sys & 0xF00) != 0x200 || (chip & 0xFFFF) != 0x6626) {
    JLINK_SYS_Report("OM_CAPTURE_WRONG_SYS: stable foreign SYS revision; stopping.");
    return -1;
  }
  if (_RequireHeld != 0) {
    // A restart clears the debug halt or sets S_RESET_ST. Never halt a
    // replacement/restarted core here to manufacture a passing handoff.
    v = _Read32(0xE000EDF0);
    if ((v & 0x02020003) == 0x20003) { return 0; }
    return 1;
  }
  r = JLINK_CORESIGHT_WriteAP(JLINK_CORESIGHT_AP_REG_ADDR, 0xE000EDF0);
  r |= JLINK_CORESIGHT_WriteAP(JLINK_CORESIGHT_AP_REG_DATA, 0xA05F0003);
  if (r < 0) { return 1; }
  v = _Read32(0xE000EDF0);
  if ((v & 0x20003) != 0x20003) { return _Unstable(); }
  return 0;
}

int InitTarget(void) {
  int r;
  U32 start;
  U32 polls;
  CPU = CORTEX_M4;
  _RequireHeld = __REQUIRE_HELD__;
  if (_Used) { _WaitForHostStop(); return -1; }
  _Used = 1;
  JLINK_SYS_Report("OM_CAPTURE_READY: continuous SWD polling active; power on now.");
  start = JLINK_GetTime();
  polls = 0;
  do {
    polls = polls + 1;
    r = _TryOm();
    if (r == 0) {
      JLINK_SYS_Report1("OM_CAPTURE_POLLS=", polls);
      JLINK_SYS_Report1("OM_CAPTURE_ELAPSED_MS=", JLINK_GetTime() - start);
      JLINK_SYS_Report("OM_CAPTURE_HALTED: OM core held for handoff.");
      return 0;
    }
    if (_RequireHeld != 0) {
      JLINK_SYS_Report("OM_CAPTURE_HANDOFF_LOST: captured halt does not persist.");
      _WaitForHostStop();
      return -1;
    }
    if (r < 0) { _WaitForHostStop(); return -1; }
    JLINK_SYS_Sleep(1);
  } while ((JLINK_GetTime() - start) < __WINDOW_MS__);
  JLINK_SYS_Report1("OM_CAPTURE_POLLS=", polls);
  JLINK_SYS_Report1("OM_CAPTURE_ELAPSED_MS=", JLINK_GetTime() - start);
  JLINK_SYS_Report("OM_CAPTURE_TIMEOUT: continuous capture ended without a qualified target.");
  _WaitForHostStop();
  return -1;
}
